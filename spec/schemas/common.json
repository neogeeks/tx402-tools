{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tools.tx402.io/api/v1/schemas/common",
  "title": "tx402 tools — shared types",
  "description": "Frozen. See spec/SPEC.md §4. Amendments are versioned with the schema.",
  "$defs": {
    "Timestamp": {
      "type": "string",
      "description": "RFC 3339, UTC, second precision, Z suffix.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "AtomicAmount": {
      "type": "string",
      "description": "Canonical atomic integer as a decimal string. No sign, no point, no leading zeros.",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "EndpointId": {
      "type": "string",
      "description": "First 32 hex chars of SHA-256 over the canonical URL (SPEC §1.5).",
      "pattern": "^[0-9a-f]{32}$"
    },
    "Hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "Url": { "type": "string", "format": "uri", "maxLength": 4096 },

    "ScoreVersion": {
      "type": "string",
      "description": "'v' + monotonic integer. Scores are comparable only within one version (SPEC §7).",
      "pattern": "^v[0-9]+$"
    },

    "Band": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },

    "WireForm": { "type": "string", "enum": ["v2-header", "v1-body", "both", "none"] },

    "Warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "maxLength": 500 }
      }
    },

    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implemented", "cached"],
      "properties": {
        "implemented": {
          "type": "boolean",
          "description": "false ⇒ this is an stub; data is schema-valid and empty. SPEC §2."
        },
        "cached": { "type": "boolean" },
        "cache_age_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "score_version": {
          "oneOf": [{ "$ref": "#/$defs/ScoreVersion" }, { "type": "null" }]
        },
        "tx402_version": { "type": ["string", "null"] },
        "schema": { "type": ["string", "null"] }
      }
    },

    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "symbol", "decimals", "recognized"],
      "properties": {
        "address": { "type": ["string", "null"], "maxLength": 128 },
        "symbol": { "type": ["string", "null"], "maxLength": 32 },
        "decimals": { "type": ["integer", "null"], "minimum": 0, "maximum": 36 },
        "recognized": {
          "type": ["boolean", "null"],
          "description": "Present in the tx402 signed release manifest. Nothing more is claimed."
        }
      }
    },

    "Requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "network",
        "network_recognized",
        "asset",
        "amount_atomic",
        "amount_decimal",
        "pay_to",
        "pay_to_dynamic",
        "max_timeout_seconds",
        "resource"
      ],
      "properties": {
        "scheme": { "type": ["string", "null"], "maxLength": 64 },
        "network": {
          "type": ["string", "null"],
          "description": "CAIP-2 network id, e.g. eip155:8453.",
          "maxLength": 128
        },
        "network_recognized": { "type": ["boolean", "null"] },
        "asset": { "oneOf": [{ "$ref": "#/$defs/Asset" }, { "type": "null" }] },
        "amount_atomic": {
          "description": "null when the challenge's amount is not a canonical atomic integer; the raw value is then in amount_raw.",
          "oneOf": [{ "$ref": "#/$defs/AtomicAmount" }, { "type": "null" }]
        },
        "amount_raw": { "type": ["string", "null"], "maxLength": 128 },
        "amount_decimal": {
          "type": ["string", "null"],
          "description": "Display only. Never do arithmetic on this (SPEC §1.4)."
        },
        "pay_to": { "type": ["string", "null"], "maxLength": 128 },
        "pay_to_dynamic": {
          "type": ["boolean", "null"],
          "description": "The challenge DECLARES a dynamic payTo scheme. See SPEC §6.4 — this is the carve-out that stops the tool crying wolf at marketplaces."
        },
        "max_timeout_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "resource": { "type": ["string", "null"], "maxLength": 4096 },
        "mime_type": { "type": ["string", "null"], "maxLength": 255 },
        "description": { "type": ["string", "null"], "maxLength": 2000 },
        "facilitator": { "type": ["string", "null"], "maxLength": 4096 },
        "extra": {
          "type": ["object", "null"],
          "description": "Unknown challenge fields, preserved verbatim."
        }
      }
    },

    "DecodeError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "maxLength": 500 }
      }
    },

    "Challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wire_form", "x402_version", "valid", "decode_error", "accepts", "requirement_count"],
      "properties": {
        "wire_form": { "$ref": "#/$defs/WireForm" },
        "x402_version": { "type": ["integer", "null"], "minimum": 0 },
        "valid": {
          "type": "boolean",
          "description": "The verdict of decodePaymentRequired imported from tx402. There is no second decoder in this repo."
        },
        "decode_error": { "oneOf": [{ "$ref": "#/$defs/DecodeError" }, { "type": "null" }] },
        "accepts": { "type": "array", "items": { "$ref": "#/$defs/Requirement" }, "maxItems": 64 },
        "requirement_count": { "type": "integer", "minimum": 0 },
        "raw_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "hash": { "oneOf": [{ "$ref": "#/$defs/Hash" }, { "type": "null" }] },
        "raw": { "type": ["string", "null"], "description": "As served, truncated to the documented cap. Public data." }
      }
    },

    "ChallengeInput": {
      "type": "object",
      "additionalProperties": false,
      "description": "Exactly one of header / body / raw.",
      "properties": {
        "header": { "type": ["string", "null"], "maxLength": 131072 },
        "body": { "type": ["object", "string", "null"] },
        "raw": { "type": ["string", "null"], "maxLength": 131072 }
      },
      "anyOf": [
        { "required": ["header"], "properties": { "header": { "type": "string" } } },
        { "required": ["body"], "properties": { "body": { "type": ["object", "string"] } } },
        { "required": ["raw"], "properties": { "raw": { "type": "string" } } }
      ]
    },

    "Check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "offline"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "status": {
          "type": "string",
          "enum": ["pass", "warn", "fail", "skip"],
          "description": "'skip' means the check could not run. It is never counted as a pass."
        },
        "offline": { "type": "boolean" },
        "reason": { "type": ["string", "null"], "maxLength": 128 },
        "detail": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },

    "Signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "observed"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "value": { "type": ["boolean", "number", "string", "null"] },
        "observed": {
          "type": "boolean",
          "description": "false ⇒ we could not determine it. An unobserved signal is NOT scored as a failure (SPEC §6.3)."
        },
        "detail": { "type": ["string", "null"], "maxLength": 500 }
      }
    },

    "RiskReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "status", "weight", "message"],
      "properties": {
        "signal_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "status": { "type": "string", "enum": ["pass", "warn", "fail", "skip"] },
        "weight": { "type": "number" },
        "message": { "type": "string", "maxLength": 500 }
      }
    },

    "Risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "band", "score_version", "confidence", "signals_evaluated", "reasons", "methodology_url"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band": {
          "$ref": "#/$defs/Band",
          "description": "A statement about our observations, not about the operator (SPEC §4.5)."
        },
        "score_version": { "$ref": "#/$defs/ScoreVersion" },
        "confidence": { "type": "string", "enum": ["static_only", "with_history"] },
        "signals_evaluated": { "type": "integer", "minimum": 0 },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/RiskReason" } },
        "methodology_url": { "type": "string" }
      }
    },

    "ChangeKind": {
      "type": "string",
      "enum": [
        "first_seen", "price", "recipient", "network", "asset", "scheme", "timeout",
        "facilitator", "resource", "challenge_shape", "wire_version",
        "availability_state", "status", "correction"
      ]
    },

    "TermChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "changed_at", "change_kind", "field", "old_value", "new_value"],
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "changed_at": { "$ref": "#/$defs/Timestamp" },
        "change_kind": { "$ref": "#/$defs/ChangeKind" },
        "field": { "type": "string", "maxLength": 64 },
        "old_value": { "type": ["string", "null"], "maxLength": 2000 },
        "new_value": { "type": ["string", "null"], "maxLength": 2000 },
        "detected_by": { "type": "string", "enum": ["crawler", "human", "api", "backfill"] },
        "score_version": { "oneOf": [{ "$ref": "#/$defs/ScoreVersion" }, { "type": "null" }] }
      }
    },

    "ProbeMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "http_status", "latency_ms", "redirect_count", "served_from_cache"],
      "properties": {
        "observed_at": { "$ref": "#/$defs/Timestamp" },
        "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
        "redirect_count": { "type": "integer", "minimum": 0, "maximum": 3 },
        "tls": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "protocol": { "type": ["string", "null"], "maxLength": 32 }
          }
        },
        "bytes_read": { "type": ["integer", "null"], "minimum": 0 },
        "served_from_cache": { "type": "boolean" },
        "cache_age_seconds": { "type": ["integer", "null"], "minimum": 0 }
      }
    },

    "Target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "canonical_url", "endpoint_id", "origin", "host"],
      "properties": {
        "url": { "type": ["string", "null"], "maxLength": 4096 },
        "canonical_url": { "type": ["string", "null"], "maxLength": 4096 },
        "endpoint_id": { "oneOf": [{ "$ref": "#/$defs/EndpointId" }, { "type": "null" }] },
        "origin": { "type": ["string", "null"], "maxLength": 2048 },
        "host": { "type": ["string", "null"], "maxLength": 255 }
      }
    }
  }
}
