{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tools.tx402.io/api/v1/schemas/error",
  "title": "Error envelope",
  "description": "One envelope for every failure at every route. SPEC §3. Note that CHALLENGE_MALFORMED, NOT_X402 and NO_DATA are results, not HTTP errors — an endpoint being broken is the answer the user came for.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "generated_at", "error"],
  "properties": {
    "api_version": { "type": "string", "const": "v1" },
    "generated_at": { "$ref": "https://tools.tx402.io/api/v1/schemas/common#/$defs/Timestamp" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Closed vocabulary. Adding a code is an addendum plus a schema bump.",
          "enum": [
            "BAD_REQUEST",
            "VALIDATION_FAILED",
            "UNSUPPORTED_MEDIA_TYPE",
            "NOT_ACCEPTABLE",
            "METHOD_NOT_ALLOWED",
            "NOT_FOUND",
            "URL_SCHEME_NOT_ALLOWED",
            "URL_USERINFO_PRESENT",
            "URL_BLOCKED",
            "URL_PRIVATE_ADDRESS",
            "TOO_MANY_REDIRECTS",
            "PROBE_TIMEOUT",
            "PROBE_FAILED",
            "RESPONSE_TOO_LARGE",
            "CHALLENGE_MALFORMED",
            "NOT_X402",
            "RATE_LIMITED",
            "TARGET_RATE_LIMITED",
            "TURNSTILE_REQUIRED",
            "TURNSTILE_FAILED",
            "ENDPOINT_OPTED_OUT",
            "NO_DATA",
            "NOT_IMPLEMENTED",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 500,
          "description": "One sentence, safe to display. Never a path, never a stack, never anything that helps map an internal network."
        },
        "detail": { "type": ["object", "null"] },
        "retryable": { "type": "boolean" },
        "docs": { "type": ["string", "null"] }
      }
    }
  }
}
