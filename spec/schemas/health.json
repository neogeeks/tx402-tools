{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tools.tx402.io/api/v1/schemas/health",
  "title": "Health and meta response",
  "description": "SPEC §5.8. /health reports binding reachability; /meta reports the versions every other answer is stamped with.",
  "allOf": [
    { "$ref": "https://tools.tx402.io/api/v1/schemas/envelope" },
    {
      "type": "object",
      "properties": {
        "tool": { "enum": ["health", "meta"] },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "bindings": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "db": { "type": ["boolean", "null"] },
                "analytics": { "type": ["boolean", "null"] },
                "queue": { "type": ["boolean", "null"] },
                "limiter": { "type": ["boolean", "null"] },
                "assets": { "type": ["boolean", "null"] }
              }
            },
            "limits": {
              "description": "The abuse and cost limits that are actually in force, so a reader can check docs/cost-model.md and docs/privacy.md against the running service instead of taking them on trust.",
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "turnstile": {
                  "description": "True only when BOTH the site key and the secret are configured. A site key alone renders a widget nothing verifies.",
                  "type": ["boolean", "null"]
                },
                "on_demand_probes_remaining_today": {
                  "description": "Outbound probes the public can still cause before the UTC day rolls. Null when the limiter could not be read.",
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "on_demand_probes_per_day": {
                  "description": "The whole-service daily ceiling on public-initiated probes.",
                  "type": ["integer", "null"],
                  "minimum": 0
                }
              }
            },
            "versions": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "api_version": { "type": "string" },
                "score_version": {
                  "oneOf": [
                    { "$ref": "https://tools.tx402.io/api/v1/schemas/common#/$defs/ScoreVersion" },
                    { "type": "null" }
                  ]
                },
                "tx402_version": { "type": ["string", "null"] },
                "schema_version": { "type": ["string", "null"] },
                "environment": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  ]
}
