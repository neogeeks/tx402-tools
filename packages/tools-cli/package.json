    "url": "git+https://github.com/neogeeks/tx402-tools.git",
    "directory": "packages/tools-cli"
  },
  "bugs": { "url": "https://github.com/neogeeks/tx402-tools/issues" },
  "type": "module",
  "bin": { "tx402-tools": "bin/tx402-tools.mjs" },
